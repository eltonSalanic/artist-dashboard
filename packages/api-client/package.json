{
  "name": "@artist/api-client",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "tsc --noEmit && jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@artist/shared": "*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.101.3",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "@supabase/supabase-js": "^2.117.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "moduleNameMapper": {
      "^@artist/shared$": "<rootDir>/../../../packages/shared/src",
      "^@artist/shared/(.*)$": "<rootDir>/../../../packages/shared/src/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.tsx?$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
