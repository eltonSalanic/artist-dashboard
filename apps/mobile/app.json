{
  "expo": {
    "name": "Band Wall",
    "slug": "artist-dashboard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artistdashboard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bandwall.app",
      "appleTeamId": "242S9Y93M9",
      "supportsTablet": false
    },
    "android": {
      "package": "com.bandwall.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you attach photos and videos to your band's tasks.",
          "cameraPermission": "Lets you take a photo and attach it to a task.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-notifications",
      [
        "@sentry/react-native",
        {
          "organization": "elton-salanic",
          "project": "band-wall-mobile",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "018024d5-3c2a-4c30-aff4-21fbc1661a4f"
      }
    },
    "owner": "eltons"
  }
}
