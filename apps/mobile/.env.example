# A phone is not your laptop: `localhost` resolves to the phone itself, so every
# URL here has to be the LAN address of the machine running the stack.
# Find it with: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
# The anon key, same one apps/web embeds. Printed by `npx supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
