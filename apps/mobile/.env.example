# A phone is not your laptop: `localhost` resolves to the phone itself. Leave
# these two out and a dev build uses the address Metro is served from, so it
# follows you between networks. Set them only to point somewhere else.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321

# development | staging | production. EAS builds set this per profile in
# eas.json; leave it unset for local dev.
# EXPO_PUBLIC_APP_ENV=development
# Sentry DSN. Unset = no error reporting. Needs a build made after the
# @sentry/react-native plugin was added (Oct 2026).
# EXPO_PUBLIC_SENTRY_DSN=

# Subscriptions (docs/billing.md). RevenueCat public SDK keys per platform; unset
# hides buying. Until the stores are connected, a RevenueCat Test Store key
# (test_...) in both works on either platform. Needs a dev build made after
# react-native-purchases was added (Oct 2026).
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
