# A phone is not your laptop: `localhost` resolves to the phone itself. Leave
# these two out and a dev build uses the address Metro is served from, so it
# follows you between networks. Set them only to point somewhere else.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
# The anon key, same one apps/web embeds. Printed by `npx supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# development | staging | production. EAS builds set this per profile in
# eas.json; leave it unset for local dev.
# EXPO_PUBLIC_APP_ENV=development
