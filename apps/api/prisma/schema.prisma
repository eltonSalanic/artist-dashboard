// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BoardRole {
  ADMIN
  USER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

model User {
  id            String                   @id @db.Uuid // = Supabase auth user id
  email         String                   @unique
  displayName   String
  avatarUrl     String?
  createdAt     DateTime                 @default(now())
  memberships   Membership[]
  sentInvites   Invite[]                 @relation("InvitedBy")
  createdTasks  Task[]                   @relation("TaskCreatedBy")
  taskAssignees TaskAssignee[]
  layouts       UserLayout[]
  comments      Comment[]
  attachments   Attachment[]
  activities    Activity[]
  mentions      MentionNotification[]
  emails        EmailDelivery[]
  emailPrefs    NotificationPreference[]
}

model Board {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String
  defaultLayout Json                     @default("[]")
  /// Board-wide appearance (palette + per-widget color slots). Starts empty and
  /// is normalized by `resolveBoardTheme` on read, so no backfill is needed.
  theme         Json                     @default("{}")
  /// IANA zone the board's wall-clock notifications fire in (day-of show
  /// summary, tasks-due-tomorrow digest). A band shares a local time.
  timezone      String                   @default("America/Los_Angeles")
  createdAt     DateTime                 @default(now())
  memberships   Membership[]
  invites       Invite[]
  statuses      TaskStatus[]
  tasks         Task[]
  userLayouts   UserLayout[]
  goals         Goal[]
  events        Event[]
  focusPins     FocusPin[]
  reminders     Reminder[]
  comments      Comment[]
  attachments   Attachment[]
  activities    Activity[]
  customWidget  CustomWidgetContent?
  mentions      MentionNotification[]
  emails        EmailDelivery[]
  emailPrefs    NotificationPreference[]
}

model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  boardId   String    @db.Uuid
  userId    String    @db.Uuid
  role      BoardRole @default(USER)
  createdAt DateTime  @default(now())
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  boardId     String       @db.Uuid
  email       String
  role        BoardRole    @default(USER)
  status      InviteStatus @default(PENDING)
  invitedById String       @db.Uuid
  createdAt   DateTime     @default(now())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([boardId, email])
  @@index([email])
}

model TaskStatus {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  color     String
  sortOrder Int
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  boardId        String          @db.Uuid
  title          String
  description    String?
  priority       Priority        @default(MEDIUM)
  statusId       String          @db.Uuid
  dueDate        DateTime?
  sortOrder      Float
  parentTaskId   String?         @db.Uuid
  goalId         String?         @db.Uuid
  eventId        String?         @db.Uuid
  createdById    String          @db.Uuid
  archivedAt     DateTime?
  /// Id of the event, goal or parent task this was archived as part of. Null
  /// when archived on its own — drives the "also restore" prompt. Deliberately
  /// no FK: it points at three different tables.
  archivedWithId String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status         TaskStatus      @relation(fields: [statusId], references: [id])
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  parentTask     Task?           @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]          @relation("Subtasks")
  createdBy      User            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignees      TaskAssignee[]
  checklist      ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]

  @@index([boardId, sortOrder])
  @@index([parentTaskId])
  @@index([statusId])
  @@index([goalId])
  @@index([eventId])
  @@index([boardId, archivedAt])
  @@index([archivedWithId])
}

enum EventType {
  SHOW
  MEETING
  REHEARSAL
}

enum GoalPeriod {
  YEARLY
  MONTHLY
  DAILY
}

enum FocusPeriod {
  WEEK
  MONTH
  YEAR
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  boardId     String     @db.Uuid
  title       String
  description String?
  period      GoalPeriod @default(MONTHLY)
  dueDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([boardId, period])
  @@index([boardId, archivedAt])
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @db.Uuid
  type        EventType
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([boardId, startsAt])
  @@index([boardId, archivedAt])
}

model FocusPin {
  id        String      @id @default(uuid()) @db.Uuid
  boardId   String      @db.Uuid
  period    FocusPeriod
  text      String
  updatedAt DateTime    @updatedAt
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, period])
}

model Reminder {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @db.Uuid
  title       String
  description String?
  remindAt    DateTime?
  done        Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, remindAt])
  @@index([boardId, archivedAt])
}

model TaskAssignee {
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  /// Identity of *this* assignment. The composite id makes a duplicate row
  /// impossible, so this timestamp is stable per assignment — which is what
  /// lets the notification dedupe key tell a genuine re-assignment apart from
  /// a concurrent double-write. See docs/notifications.md.
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  text      String
  done      Boolean  @default(false)
  sortOrder Float
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id          String       @id @default(uuid()) @db.Uuid
  boardId     String       @db.Uuid
  taskId      String       @db.Uuid
  authorId    String       @db.Uuid
  /// Markdown source; rendered client-side.
  body        String
  /// User ids referenced by an @mention in the body.
  mentions    String[]     @db.Uuid
  editedAt    DateTime?
  createdAt   DateTime     @default(now())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([boardId])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  boardId      String   @db.Uuid
  /// Object key inside the private `attachments` bucket.
  storagePath  String   @unique
  fileName     String
  mimeType     String
  size         Int
  taskId       String?  @db.Uuid
  commentId    String?  @db.Uuid
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([commentId])
  @@index([boardId, createdAt])
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  STATUS_CHANGED
  MEMBER_ASSIGNED
  MEMBER_REMOVED
  GOAL_COMPLETED
  FILE_UPLOADED
  COMMENT_ADDED
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  boardId   String       @db.Uuid
  type      ActivityType
  /// Null once the actor's account is gone — the feed entry outlives them.
  actorId   String?      @db.Uuid
  /// Denormalized snapshot (titles, names, ids) so the feed never joins.
  meta      Json         @default("{}")
  createdAt DateTime     @default(now())
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}

model CustomWidgetContent {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @unique @db.Uuid
  title     String   @default("Notes")
  /// TipTap document, stored verbatim.
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

/// A "you were mentioned" notification for a single recipient. Fields are a
/// denormalized snapshot (like Activity) so the list never joins and outlives
/// the comment that spawned it.
model MentionNotification {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  /// Recipient — the mentioned user.
  userId    String   @db.Uuid
  /// Task the mentioning comment lives on, for navigation.
  taskId    String   @db.Uuid
  actorName String
  taskTitle String
  excerpt   String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserLayout {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  userId    String   @db.Uuid
  layout    Json
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

/// Which notification a delivery belongs to. Coarser than the trigger list on
/// purpose — people reason about categories, not individual triggers.
enum EmailCategory {
  MENTIONS
  ASSIGNMENTS
  SCHEDULE
  REMINDERS
  DUE_TASKS
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

/// Transactional outbox. Triggers write a row inside the same transaction as
/// the mutation that caused them; the dispatcher sends it *after* that commits,
/// so a mail outage can never roll back a task assignment.
model EmailDelivery {
  id        String        @id @default(uuid()) @db.Uuid
  boardId   String        @db.Uuid
  userId    String        @db.Uuid
  category  EmailCategory
  /// Template name, e.g. `task-assigned`.
  template  String
  /// Deterministic per (trigger, subject row, recipient) — the uniqueness that
  /// makes a replayed cron or a double-submit a no-op. Also sent to Resend as
  /// its Idempotency-Key, which covers the crash-after-send case this can't.
  dedupeKey String        @unique
  /// Everything the template needs, snapshotted like Activity.meta so the mail
  /// still renders after the task is renamed or deleted.
  payload   Json          @default("{}")
  status    EmailStatus   @default(QUEUED)
  attempts  Int           @default(0)
  lastError String?
  /// Backoff gate — the dispatcher only claims rows that are due.
  sendAfter DateTime      @default(now())
  sentAt    DateTime?
  createdAt DateTime      @default(now())
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, sendAfter])
  @@index([boardId, createdAt])
}

/// Per user *per board* — someone in two bands can be loud in one and quiet in
/// the other. A missing row means enabled, so there is nothing to backfill.
model NotificationPreference {
  id       String        @id @default(uuid()) @db.Uuid
  boardId  String        @db.Uuid
  userId   String        @db.Uuid
  category EmailCategory
  enabled  Boolean       @default(true)
  board    Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId, category])
}

/// Addresses that bounced or complained. Keyed by email rather than user id:
/// the address is what the mail system rejected, and it outlives the account.
model EmailSuppression {
  email     String   @id
  /// bounce | complaint | manual
  reason    String
  createdAt DateTime @default(now())
}
