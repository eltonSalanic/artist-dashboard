// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BoardRole {
  ADMIN
  USER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

model User {
  id            String         @id @db.Uuid // = Supabase auth user id
  email         String         @unique
  displayName   String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  sentInvites   Invite[]       @relation("InvitedBy")
  createdTasks  Task[]         @relation("TaskCreatedBy")
  taskAssignees TaskAssignee[]
  layouts       UserLayout[]
  comments      Comment[]
  attachments   Attachment[]
  activities    Activity[]
}

model Board {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  defaultLayout Json         @default("[]")
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  invites       Invite[]
  statuses      TaskStatus[]
  tasks         Task[]
  userLayouts   UserLayout[]
  goals         Goal[]
  events        Event[]
  focusPins     FocusPin[]
  reminders     Reminder[]
  comments      Comment[]
  attachments   Attachment[]
  activities    Activity[]
  customWidget  CustomWidgetContent?
}

model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  boardId   String    @db.Uuid
  userId    String    @db.Uuid
  role      BoardRole @default(USER)
  createdAt DateTime  @default(now())
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  boardId     String       @db.Uuid
  email       String
  role        BoardRole    @default(USER)
  status      InviteStatus @default(PENDING)
  invitedById String       @db.Uuid
  createdAt   DateTime     @default(now())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([boardId, email])
  @@index([email])
}

model TaskStatus {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  color     String
  sortOrder Int
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id           String          @id @default(uuid()) @db.Uuid
  boardId      String          @db.Uuid
  title        String
  description  String?
  priority     Priority        @default(MEDIUM)
  statusId     String          @db.Uuid
  dueDate      DateTime?
  sortOrder    Float
  parentTaskId String?         @db.Uuid
  goalId       String?         @db.Uuid
  eventId      String?         @db.Uuid
  createdById  String          @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  board        Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status       TaskStatus      @relation(fields: [statusId], references: [id])
  goal         Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  event        Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  parentTask   Task?           @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]          @relation("Subtasks")
  createdBy    User            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignees    TaskAssignee[]
  checklist    ChecklistItem[]
  comments     Comment[]
  attachments  Attachment[]

  @@index([boardId, sortOrder])
  @@index([parentTaskId])
  @@index([statusId])
  @@index([goalId])
  @@index([eventId])
}

enum EventType {
  SHOW
  MEETING
  REHEARSAL
}

enum GoalPeriod {
  YEARLY
  MONTHLY
  DAILY
}

enum FocusPeriod {
  WEEK
  MONTH
  YEAR
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  boardId     String     @db.Uuid
  title       String
  description String?
  period      GoalPeriod @default(MONTHLY)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([boardId, period])
}

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @db.Uuid
  type        EventType
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([boardId, startsAt])
}

model FocusPin {
  id        String      @id @default(uuid()) @db.Uuid
  boardId   String      @db.Uuid
  period    FocusPeriod
  text      String
  updatedAt DateTime    @updatedAt
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, period])
}

model Reminder {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @db.Uuid
  title       String
  description String?
  remindAt    DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, remindAt])
}

model TaskAssignee {
  taskId String @db.Uuid
  userId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  text      String
  done      Boolean  @default(false)
  sortOrder Float
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id          String       @id @default(uuid()) @db.Uuid
  boardId     String       @db.Uuid
  taskId      String       @db.Uuid
  authorId    String       @db.Uuid
  /// Markdown source; rendered client-side.
  body        String
  /// User ids referenced by an @mention in the body.
  mentions    String[]     @db.Uuid
  editedAt    DateTime?
  createdAt   DateTime     @default(now())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([boardId])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  boardId      String   @db.Uuid
  /// Object key inside the private `attachments` bucket.
  storagePath  String   @unique
  fileName     String
  mimeType     String
  size         Int
  taskId       String?  @db.Uuid
  commentId    String?  @db.Uuid
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([commentId])
  @@index([boardId, createdAt])
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  STATUS_CHANGED
  MEMBER_ASSIGNED
  MEMBER_REMOVED
  GOAL_COMPLETED
  FILE_UPLOADED
  COMMENT_ADDED
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  boardId   String       @db.Uuid
  type      ActivityType
  /// Null once the actor's account is gone — the feed entry outlives them.
  actorId   String?      @db.Uuid
  /// Denormalized snapshot (titles, names, ids) so the feed never joins.
  meta      Json         @default("{}")
  createdAt DateTime     @default(now())
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}

model CustomWidgetContent {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @unique @db.Uuid
  title     String   @default("Notes")
  /// TipTap document, stored verbatim.
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model UserLayout {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  userId    String   @db.Uuid
  layout    Json
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}
