// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BoardRole {
  ADMIN
  USER
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

model User {
  id                    String                   @id @db.Uuid // = Supabase auth user id
  email                 String                   @unique
  displayName           String
  avatarUrl             String?
  createdAt             DateTime                 @default(now())
  memberships           Membership[]
  sentInvites           Invite[]                 @relation("InvitedBy")
  createdTasks          Task[]                   @relation("TaskCreatedBy")
  taskAssignees         TaskAssignee[]
  layouts               UserLayout[]
  mobileLayouts         MobileLayout[]
  comments              Comment[]
  attachments           Attachment[]
  activities            Activity[]
  mentions              MentionNotification[]
  notifications         NotificationDelivery[]
  notifyPrefs           NotificationPreference[]
  devices               DeviceToken[]
  financeEntriesCreated FinanceEntry[]           @relation("FinanceEntryCreatedBy")
  financeEntriesHandled FinanceEntry[]           @relation("FinanceEntryHandledBy")
  financeSplits         FinanceSplit[]
  splitShares           SplitShare[]
  payouts               Payout[]                 @relation("PayoutMember")
  payoutsRecorded       Payout[]                 @relation("PayoutCreatedBy")
  links                 ItemLink[]
}

model Board {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String
  defaultLayout  Json                     @default("[]")
  /// Board-wide appearance (palette + per-widget color slots). Starts empty and
  /// is normalized by `resolveBoardTheme` on read, so no backfill is needed.
  theme          Json                     @default("{}")
  /// IANA zone the board's wall-clock notifications fire in (day-of show
  /// summary, tasks-due-tomorrow digest). A band shares a local time.
  timezone       String                   @default("America/Los_Angeles")
  /// ISO 4217 code the band keeps its books in. One currency per board.
  currency       String                   @default("USD")
  createdAt      DateTime                 @default(now())
  memberships    Membership[]
  invites        Invite[]
  statuses       TaskStatus[]
  tasks          Task[]
  userLayouts    UserLayout[]
  mobileLayouts  MobileLayout[]
  goals          Goal[]
  events         Event[]
  focusPins      FocusPin[]
  reminders      Reminder[]
  comments       Comment[]
  attachments    Attachment[]
  notes          Note[]
  activities     Activity[]
  customWidget   CustomWidgetContent?
  mentions       MentionNotification[]
  notifications  NotificationDelivery[]
  notifyPrefs    NotificationPreference[]
  financeEntries FinanceEntry[]
  splitShares    SplitShare[]
  payouts        Payout[]
  links          ItemLink[]
}

model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  boardId   String    @db.Uuid
  userId    String    @db.Uuid
  role      BoardRole @default(USER)
  createdAt DateTime  @default(now())
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(uuid()) @db.Uuid
  boardId     String       @db.Uuid
  email       String
  role        BoardRole    @default(USER)
  status      InviteStatus @default(PENDING)
  invitedById String       @db.Uuid
  createdAt   DateTime     @default(now())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([boardId, email])
  @@index([email])
}

model TaskStatus {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  color     String
  sortOrder Int
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  boardId        String          @db.Uuid
  title          String
  priority       Priority        @default(MEDIUM)
  statusId       String          @db.Uuid
  dueDate        DateTime?
  sortOrder      Float
  parentTaskId   String?         @db.Uuid
  goalId         String?         @db.Uuid
  eventId        String?         @db.Uuid
  createdById    String          @db.Uuid
  archivedAt     DateTime?
  /// Id of the event, goal or parent task this was archived as part of. Null
  /// when archived on its own — drives the "also restore" prompt. Deliberately
  /// no FK: it points at three different tables.
  archivedWithId String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status         TaskStatus      @relation(fields: [statusId], references: [id])
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  parentTask     Task?           @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]          @relation("Subtasks")
  createdBy      User            @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignees      TaskAssignee[]
  checklist      ChecklistItem[]
  notes          Note[]
  comments       Comment[]
  attachments    Attachment[]
  links          ItemLink[]

  @@index([boardId, sortOrder])
  @@index([parentTaskId])
  @@index([statusId])
  @@index([goalId])
  @@index([eventId])
  @@index([boardId, archivedAt])
  @@index([archivedWithId])
}

enum EventType {
  SHOW
  MEETING
  REHEARSAL
}

enum GoalPeriod {
  YEARLY
  MONTHLY
  DAILY
}

enum FocusPeriod {
  WEEK
  MONTH
  YEAR
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  boardId     String     @db.Uuid
  title       String
  period      GoalPeriod @default(MONTHLY)
  dueDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]
  notes       Note[]
  links       ItemLink[]

  @@index([boardId, period])
  @@index([boardId, archivedAt])
}

model Event {
  id             String         @id @default(uuid()) @db.Uuid
  boardId        String         @db.Uuid
  type           EventType
  title          String
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  board          Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks          Task[]
  attachments    Attachment[]
  notes          Note[]
  financeEntries FinanceEntry[]
  links          ItemLink[]

  @@index([boardId, startsAt])
  @@index([boardId, archivedAt])
}

model FocusPin {
  id        String      @id @default(uuid()) @db.Uuid
  boardId   String      @db.Uuid
  period    FocusPeriod
  text      String
  updatedAt DateTime    @updatedAt
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, period])
}

model Reminder {
  id         String     @id @default(uuid()) @db.Uuid
  boardId    String     @db.Uuid
  title      String
  remindAt   DateTime?
  done       Boolean    @default(false)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  notes      Note[]
  links      ItemLink[]

  @@index([boardId, remindAt])
  @@index([boardId, archivedAt])
}

model TaskAssignee {
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  /// Identity of *this* assignment. The composite id makes a duplicate row
  /// impossible, so this timestamp is stable per assignment — which is what
  /// lets the notification dedupe key tell a genuine re-assignment apart from
  /// a concurrent double-write. See docs/notifications.md.
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  text      String
  done      Boolean  @default(false)
  sortOrder Float
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// A titled, plain-text note on a task, event, goal or reminder. Exactly one
/// of the four parent ids is set (enforced by a CHECK constraint in the
/// migration). Replaced the single `description` field, which the
/// migration copied into a first note titled "Notes".
model Note {
  id         String    @id @default(uuid()) @db.Uuid
  boardId    String    @db.Uuid
  taskId     String?   @db.Uuid
  eventId    String?   @db.Uuid
  goalId     String?   @db.Uuid
  reminderId String?   @db.Uuid
  title      String
  body       String    @default("")
  sortOrder  Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  reminder   Reminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([eventId])
  @@index([goalId])
  @@index([reminderId])
  @@index([boardId])
}

model Comment {
  id          String       @id @default(uuid()) @db.Uuid
  boardId     String       @db.Uuid
  taskId      String       @db.Uuid
  authorId    String       @db.Uuid
  /// Markdown source; rendered client-side.
  body        String
  /// User ids referenced by an @mention in the body.
  mentions    String[]     @db.Uuid
  editedAt    DateTime?
  createdAt   DateTime     @default(now())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([boardId])
}

model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  boardId        String        @db.Uuid
  /// Object key inside the private `attachments` bucket.
  storagePath    String        @unique
  fileName       String
  mimeType       String
  size           Int
  taskId         String?       @db.Uuid
  commentId      String?       @db.Uuid
  /// A show's rider, stage plot or setlist — any event can carry files.
  eventId        String?       @db.Uuid
  /// A receipt on a ledger entry.
  financeEntryId String?       @db.Uuid
  uploadedById   String        @db.Uuid
  createdAt      DateTime      @default(now())
  board          Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment        Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  financeEntry   FinanceEntry? @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  uploadedBy     User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([commentId])
  @@index([eventId])
  @@index([financeEntryId])
  @@index([boardId, createdAt])
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  STATUS_CHANGED
  MEMBER_ASSIGNED
  MEMBER_REMOVED
  GOAL_COMPLETED
  FILE_UPLOADED
  COMMENT_ADDED
  FINANCE_ENTRY_ADDED
  SHOW_SETTLED
  PAYOUT_RECORDED
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  boardId   String       @db.Uuid
  type      ActivityType
  /// Null once the actor's account is gone — the feed entry outlives them.
  actorId   String?      @db.Uuid
  /// Denormalized snapshot (titles, names, ids) so the feed never joins.
  meta      Json         @default("{}")
  createdAt DateTime     @default(now())
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
}

model CustomWidgetContent {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @unique @db.Uuid
  title     String   @default("Notes")
  /// TipTap document, stored verbatim.
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

/// A "you were mentioned" notification for a single recipient. Fields are a
/// denormalized snapshot (like Activity) so the list never joins and outlives
/// the comment that spawned it.
model MentionNotification {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  /// Recipient — the mentioned user.
  userId    String   @db.Uuid
  /// Task the mentioning comment lives on, for navigation.
  taskId    String   @db.Uuid
  actorName String
  taskTitle String
  excerpt   String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserLayout {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  userId    String   @db.Uuid
  layout    Json
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

/// The phone's own arrangement of a board: an ordered list of
/// `{ widgetType, size: 'full' | 'half', hidden? }` (`MobileLayoutItem` in
/// packages/shared). No row means the phone follows the web arrangement.
/// Its own table, not a column on UserLayout, because resetting the web
/// layout deletes that row.
model MobileLayout {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  userId    String   @db.Uuid
  items     Json
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

/// Which notification a delivery belongs to. Coarser than the trigger list on
/// purpose — people reason about categories, not individual triggers.
enum NotificationCategory {
  MENTIONS
  ASSIGNMENTS
  SCHEDULE
  REMINDERS
  DUE_TASKS
}

/// How a notification reaches someone. One outbox serves both: the claim,
/// backoff and drain machinery is concurrency-sensitive and duplicating it per
/// channel would mean two places to get multi-instance safety wrong. What
/// genuinely differs per channel is the transport and what counts as
/// undeliverable, and both of those are already seams.
enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// Transactional outbox. Triggers write a row inside the same transaction as
/// the mutation that caused them; the dispatcher sends it *after* that commits,
/// so a mail outage can never roll back a task assignment.
model NotificationDelivery {
  id        String               @id @default(uuid()) @db.Uuid
  boardId   String               @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel  @default(EMAIL)
  /// Template name, e.g. `task-assigned`.
  template  String
  /// Deterministic per (trigger, subject row, recipient) — the uniqueness that
  /// makes a replayed cron or a double-submit a no-op. Also sent to Resend as
  /// its Idempotency-Key, which covers the crash-after-send case this can't.
  ///
  /// Unique *with* the channel, not alone: one trigger legitimately produces an
  /// email row and a push row, and they must not dedupe each other away.
  dedupeKey String
  /// Everything the template needs, snapshotted like Activity.meta so the mail
  /// still renders after the task is renamed or deleted.
  payload   Json                 @default("{}")
  status    NotificationStatus   @default(QUEUED)
  attempts  Int                  @default(0)
  lastError String?
  /// Backoff gate — the dispatcher only claims rows that are due.
  sendAfter DateTime             @default(now())
  sentAt    DateTime?
  createdAt DateTime             @default(now())
  board     Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey, channel])
  @@index([status, sendAfter])
  @@index([boardId, createdAt])
}

/// Expo push tokens. One row per install, not per user — the same person on a
/// phone and a tablet is two rows, and both should ring.
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  /// The Expo push token.
  ///
  /// Unique per *user*, not globally. A global unique would force a
  /// re-registration under a different account to reassign the row, and then
  /// knowing someone's token would be enough to redirect their notifications
  /// to your own account and silence theirs. Handing a device over is handled
  /// by signing out (which deletes the row), not by re-registration.
  token      String
  platform   DevicePlatform
  /// Touched on every registration so a stale install can be pruned later.
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  /// Expo reports dead tokens without reference to a user, so the prune path
  /// looks rows up by token alone.
  @@index([token])
}

/// Per user *per board* — someone in two bands can be loud in one and quiet in
/// the other. A missing row means enabled, so there is nothing to backfill.
model NotificationPreference {
  id       String               @id @default(uuid()) @db.Uuid
  boardId  String               @db.Uuid
  userId   String               @db.Uuid
  category NotificationCategory
  /// Muting email for a category should not mute push for it, so the channel is
  /// part of the identity. Rows that predate push are EMAIL.
  channel  NotificationChannel  @default(EMAIL)
  enabled  Boolean              @default(true)
  board    Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId, category, channel])
}

/// Addresses that bounced or complained. Keyed by email rather than user id:
/// the address is what the mail system rejected, and it outlives the account.
model EmailSuppression {
  email     String   @id
  /// bounce | complaint | manual
  reason    String
  createdAt DateTime @default(now())
}

enum FinanceKind {
  INCOME
  EXPENSE
}

/// EXPECTED: promised, not in hand (a show fee still owed). VOID replaces
/// delete, so the books never quietly lose a row.
enum FinanceState {
  EXPECTED
  SETTLED
  VOID
}

/// One line in a band's books. Balances are computed from these and never
/// stored, so there is no running total to drift.
model FinanceEntry {
  id           String         @id @default(uuid()) @db.Uuid
  boardId      String         @db.Uuid
  kind         FinanceKind
  state        FinanceState   @default(SETTLED)
  /// A `FINANCE_CATEGORIES` key from packages/shared.
  category     String
  /// Always positive; `kind` gives the sign. Board currency, minor units.
  amountCents  Int
  occurredOn   DateTime       @db.Date
  counterparty String?
  description  String         @default("")
  note         String         @default("")
  /// The show this money belongs to. SetNull: deleting a show never deletes
  /// its money.
  eventId      String?        @db.Uuid
  /// Member whose own money this went through (paid an expense, or pocketed
  /// income for the band). Null is the band's own account.
  handledById  String?        @db.Uuid
  /// Null once the account is gone — the books outlive it.
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  board        Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  event        Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  handledBy    User?          @relation("FinanceEntryHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("FinanceEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  splits       FinanceSplit[]
  receipts     Attachment[]

  @@index([boardId, occurredOn])
  @@index([eventId])
}

/// How one entry is divided, snapshotted from the board's split when the entry
/// is written, so changing the split later never rewrites past money.
model FinanceSplit {
  id       String       @id @default(uuid()) @db.Uuid
  entryId  String       @db.Uuid
  /// Null is the band fund. A deleted account's share falls back to the fund.
  userId   String?      @db.Uuid
  shareBps Int
  entry    FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entryId])
}

/// The board's default split. No rows means equal shares among members.
model SplitShare {
  id       String  @id @default(uuid()) @db.Uuid
  boardId  String  @db.Uuid
  /// Null is the band fund.
  userId   String? @db.Uuid
  shareBps Int
  board    Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

/// Money that changed hands between the band and a member outside the app.
model Payout {
  id          String   @id @default(uuid()) @db.Uuid
  boardId     String   @db.Uuid
  userId      String   @db.Uuid
  /// Positive: the band paid the member. Negative: the member paid the band.
  amountCents Int
  paidOn      DateTime @db.Date
  note        String   @default("")
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user        User     @relation("PayoutMember", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([boardId, paidOn])
}

/// Named external web links; each belongs to exactly one item.
model ItemLink {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @db.Uuid
  taskId      String?   @db.Uuid
  eventId     String?   @db.Uuid
  goalId      String?   @db.Uuid
  reminderId  String?   @db.Uuid
  title       String
  url         String
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  reminder    Reminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([boardId, taskId])
  @@index([boardId, eventId])
  @@index([boardId, goalId])
  @@index([boardId, reminderId])
  @@index([taskId])
  @@index([eventId])
  @@index([goalId])
  @@index([reminderId])
  @@index([createdById])
}
