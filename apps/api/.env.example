DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase start`>
# Signs Better Auth sessions and invite codes. Any 32+ random characters,
# e.g. `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=<32+ random characters>
# Deployment tier: development (default), staging or production. Staging runs
# with NODE_ENV=production so real mail and push work, so this is what tells
# the two apart: JSON logs, required public URLs, the error reporter's tag.
APP_ENV=development
# error | warn | log | debug | verbose. Defaults to debug in dev, log elsewhere.
# LOG_LEVEL=debug
# Sentry project DSN. Unset = no error reporting (local dev).
# SENTRY_DSN=
PORT=3001
WEB_URL=http://localhost:3000
# The API's own public URL — the one-click unsubscribe header points here,
# since the web app is a static client bundle and can't answer a POST.
API_URL=http://localhost:3001

# --- Email notifications -------------------------------------------------
# Dev sends to Mailpit; only NODE_ENV=production talks to Resend.
MAIL_FROM=Band Wall <onboarding@resend.dev>
RESEND_API_KEY=<from resend.com — production only>
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
UNSUBSCRIBE_SECRET=<any 32+ random bytes>
# Signing secret for the Resend bounce/complaint webhook (whsec_...). Without
# it the endpoint rejects everything rather than trusting unsigned events.
RESEND_WEBHOOK_SECRET=<from the webhook you create in resend.com>

# Expo push. Only needed once the Expo project enables push security — the
# transport works without it. Push is a no-op outside NODE_ENV=production, for
# the same reason mail goes to Mailpit: a dev run must not buzz a real phone.
EXPO_ACCESS_TOKEN=<from expo.dev — optional, production only>
# Set to true to send real pushes from a local API, for testing the phone app's
# development build. Only phones that signed in and allowed notifications have a
# token to send to, so the demo seed's bandmates still receive nothing.
PUSH_IN_DEV=false

# --- Scripts (read only by the scripts, not the running API) ---------------
# Whose board `npm run db:seed` fills. Defaults to the project owner's account.
# DEMO_OWNER_EMAIL=you@example.com
# Where `npm run mail:test` sends its diagnostic email.
# MAIL_TEST_EMAIL=you@example.com

# --- Billing (Band Pro, docs/billing.md) ----------------------------------
# true closes every board route with a 402 until the board has Band Pro.
# Leave false locally so existing boards keep working; true on staging/prod.
BILLING_ENFORCED=false
# The Authorization header value set on the RevenueCat webhook (16+ chars).
# Without it the webhook rejects everything.
# REVENUECAT_WEBHOOK_AUTH=<a long random string, e.g. `openssl rand -hex 32`>
