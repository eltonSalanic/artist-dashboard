# API environment. Copy to apps/api/.env for local dev; on Railway, set these as
# service variables instead (no .env file there).
#
# Each line says when it's needed:
#   [required]   the API refuses to start without it
#   [deployed]   required on staging and production (APP_ENV set), optional locally
#   [prod mail]  only read when NODE_ENV=production
#   [optional]   has a sensible default
# What APP_ENV and NODE_ENV change, in full: docs/environments.md.

# --- Environment ---------------------------------------------------------------
# [optional] Which deployment this is: development (default) | staging |
# production. Changes how the API reports on itself: default log level,
# required public URLs, the Sentry tag. Never changes behaviour for users.
APP_ENV=development
# [optional] Whether email and push are real. ONLY the exact value `production`
# sends through Resend and Expo; anything else (unset, development, staging)
# sends mail to Mailpit and drops pushes. Staging and production servers set it
# to production. Leave it unset locally, or set it to production for a few
# minutes to test real email (it also makes push real).
# NODE_ENV=production
# [optional] error | warn | log | debug | verbose. Defaults to debug when APP_ENV
# is development and log otherwise, which hides debug lines such as where an
# email went. Set debug on staging while chasing something.
# LOG_LEVEL=debug
# [optional] pretty | json. Defaults to json on Railway (RAILWAY_PROJECT_ID is
# set) and readable coloured lines everywhere else, including a local run with
# APP_ENV=staging.
# LOG_FORMAT=json
# [optional] Port to listen on. Railway sets this itself.
PORT=3001

# --- Database ------------------------------------------------------------------
# [required] Postgres connection string. Locally, the Supabase stack's database
# (`npx supabase status`). On Supabase in prod, the pooled one (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Sign-in -------------------------------------------------------------------
# [required] Signs Better Auth sessions, invite codes and sign-up codes. Any 32+
# random characters, e.g. `openssl rand -base64 32`. Changing it signs everyone
# out. Use a different one per environment.
BETTER_AUTH_SECRET=<32+ random characters>
# [optional] Sign in with Apple and Google (docs/sign-in.md). The iOS app's
# bundle ID: native Apple sign-in tokens are issued for it. Defaults to
# com.bandwall.app.
# APPLE_BUNDLE_ID=com.bandwall.app
# [optional] Only for Apple sign-in on the web or Android (not used yet).
# APPLE_SERVICE_ID=
# [optional] Every Google OAuth client ID whose ID tokens are accepted,
# comma-separated: iOS, Android and Web. Unset = Google sign-in is off. Public,
# not secrets.
# GOOGLE_CLIENT_IDS=<ios>.apps.googleusercontent.com,<android>...,<web>...

# --- Public URLs ---------------------------------------------------------------
# [deployed] The web app's URL: allowed to call the API from a browser (CORS),
# and where invite and email links point. Defaults to http://localhost:3000.
WEB_URL=http://localhost:3000
# [deployed] The API's own public URL: Better Auth builds its URLs from it, and
# the one-click unsubscribe header points here (the web app is a static bundle
# and can't answer a POST). Defaults to http://localhost:3001.
API_URL=http://localhost:3001

# --- File storage (docs/storage.md) --------------------------------------------
# [optional] supabase (default: the local stack) | r2 (Cloudflare R2, staging
# and prod).
# STORAGE_PROVIDER=supabase
# [required with STORAGE_PROVIDER=supabase, the default]
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `npx supabase status`>
# [required with STORAGE_PROVIDER=r2] One bucket and one token per environment;
# scope the token to Object Read & Write on that bucket only.
# R2_ACCOUNT_ID=<Cloudflare dashboard → R2 → Account ID>
# R2_ACCESS_KEY_ID=<from the bucket's R2 API token>
# R2_SECRET_ACCESS_KEY=<shown once when you create the token>
# R2_BUCKET=bandwall-attachments-dev

# --- Email (docs/notifications.md) ---------------------------------------------
# Locally, every email (notifications, invites, sign-up codes) goes to Mailpit at
# http://127.0.0.1:54324. Only NODE_ENV=production sends through Resend.
#
# [prod mail] Sender. Must be on the domain verified in Resend that the API key
# is restricted to, e.g. Band Wall <no-reply@mail-staging.yourdomain.com>.
# Locally it's only the From line Mailpit shows.
MAIL_FROM=Band Wall <dev@localhost>
# [prod mail] A Resend key with Sending access, restricted to MAIL_FROM's domain.
# One per environment. Not needed locally.
# RESEND_API_KEY=re_...
# [optional] Where Mailpit listens. Only used when NODE_ENV isn't production;
# the defaults match the local Supabase stack.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
# [required to send notification emails] Signs the unsubscribe link in every
# notification email. 32+ random bytes, e.g. `openssl rand -base64 32`. One per
# environment; changing it breaks the links in emails already sent.
UNSUBSCRIBE_SECRET=<32+ random bytes>
# [deployed] Signing secret (whsec_...) of the Resend bounce/complaint webhook
# pointing at <API_URL>/webhooks/resend. Without it the endpoint rejects every
# event rather than trusting unsigned ones.
# RESEND_WEBHOOK_SECRET=whsec_...

# --- Push (docs/notifications.md) ----------------------------------------------
# [optional] Expo access token. Only needed once the Expo project turns on push
# security; push works without it.
# EXPO_ACCESS_TOKEN=
# [optional] true sends real pushes from a local API (NODE_ENV not production),
# for testing the phone's development build. Only phones that signed in and
# allowed notifications get them, so the demo seed's bandmates still receive
# nothing. Ignored under NODE_ENV=test.
PUSH_IN_DEV=false

# --- Error reporting (docs/error-handling.md) ----------------------------------
# [optional] Sentry project DSN. Unset = no error reporting (local dev).
# SENTRY_DSN=
# Set by Railway itself, don't set them by hand. RAILWAY_GIT_COMMIT_SHA is sent
# to Sentry as the release; RAILWAY_PROJECT_ID switches logs to JSON (see
# LOG_FORMAT).
# RAILWAY_GIT_COMMIT_SHA=
# RAILWAY_PROJECT_ID=

# --- Billing (docs/billing.md) -------------------------------------------------
# [optional] true | false. true closes every band route with a 402 until the
# band's owner is subscribed. false locally so existing bands keep working;
# true on staging and production.
BILLING_ENFORCED=false
# [deployed, once billing is on] The Authorization header value set on the
# RevenueCat webhook (16+ chars). Without it the webhook rejects everything.
# REVENUECAT_WEBHOOK_AUTH=<a long random string, e.g. `openssl rand -hex 32`>
# [optional] Secret key from RevenueCat (Project settings > API keys, API version
# V1). Lets the API confirm a purchase itself when the webhook is late or can't
# reach it, as on a laptop. Server only; never put it in the web or mobile files.
# REVENUECAT_SECRET_API_KEY=

# --- Scripts (read only by `npm run` scripts, not the running API) -------------
# Whose board `npm run db:seed` fills. Defaults to the project owner's account.
# DEMO_OWNER_EMAIL=you@example.com
# Where `npm run mail:test` sends its diagnostic email. Defaults to the project
# owner's account, which must already be in a band.
# MAIL_TEST_EMAIL=you@example.com
