NEXT_PUBLIC_API_URL=http://localhost:3001

# development (default) | staging | production. Tags error reports so staging
# and production never mix.
NEXT_PUBLIC_APP_ENV=development
# Sentry browser DSN. Unset = no error reporting (local dev).
# NEXT_PUBLIC_SENTRY_DSN=

# Subscriptions (docs/billing.md). RevenueCat Web Billing public key; unset hides
# the web checkout. A test_ key uses RevenueCat's Test Store.
# NEXT_PUBLIC_REVENUECAT_WEB_KEY=
# Optional fallback when there is no web key: the RevenueCat Web Purchase Link
# (the board id is appended as the app user id).
# NEXT_PUBLIC_REVENUECAT_WEB_PURCHASE_URL=
