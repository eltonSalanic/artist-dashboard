# How to read this file
#   ##  lines are notes. Leave them as they are.
#   KEY=value          is on. Copy it as is.
#   # KEY=value        is optional and off. Delete the "# " to turn it on.
#
# Copy to apps/web/.env.local for local dev; on Vercel, set these as project
# environment variables.
#
# Every NEXT_PUBLIC_ value is baked into the bundle when Next builds it: restart
# `npm run dev` after changing one, and never put a secret here, because anyone
# can read it in the browser.
#
# NODE_ENV is not set here. Next sets it itself: development under `next dev`,
# production for `next build` / `next start` (docs/environments.md).


# ==============================================================================
# API
# ==============================================================================

## [required for a build] The API's origin. `next dev` falls back to
## http://localhost:3001; a production build fails without it.
NEXT_PUBLIC_API_URL=http://localhost:3001


# ==============================================================================
# Environment and error reporting (docs/error-handling.md)
# ==============================================================================

## [optional] development (default) | staging | production. Only tags Sentry
## reports, so staging and production never mix.
NEXT_PUBLIC_APP_ENV=development

## [optional] Sentry browser DSN. Off = no error reporting (local dev).
# NEXT_PUBLIC_SENTRY_DSN=

## [optional] The release Sentry files reports under. Defaults to the commit
## Vercel exposes as NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA, which Vercel sets itself
## on every deploy; turn this on only to override it.
# NEXT_PUBLIC_SENTRY_RELEASE=


# ==============================================================================
# Subscriptions (docs/billing.md)
# ==============================================================================

## [optional] RevenueCat Web Billing public key. Off hides the web checkout. A
## test_ key uses RevenueCat's Test Store.
# NEXT_PUBLIC_REVENUECAT_WEB_KEY=

## [optional] Fallback when there is no web key: the RevenueCat Web Purchase
## Link (the board id is appended as the app user id).
# NEXT_PUBLIC_REVENUECAT_WEB_PURCHASE_URL=
