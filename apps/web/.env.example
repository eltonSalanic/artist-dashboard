NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from `supabase start`>
NEXT_PUBLIC_API_URL=http://localhost:3001

# development (default) | staging | production. Tags error reports so staging
# and production never mix.
NEXT_PUBLIC_APP_ENV=development
# Sentry browser DSN. Unset = no error reporting (local dev).
# NEXT_PUBLIC_SENTRY_DSN=
